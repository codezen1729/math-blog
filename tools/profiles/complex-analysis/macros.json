  "\\Application": "%\n  \\Needspace{4\\baselineskip}%\n  \\par\\addvspace{.8em}%\n  {\\sffamily\\bfseries\\color{HandoutTeal}Application\\ifstrempty{#1}{}{ --- #1}}\\par\\nobreak\\vspace{.1em}%\n",
