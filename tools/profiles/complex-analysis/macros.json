  "\\ExerciseHeading": "\\par\\smallskip\\noindent{\\sffamily\\bfseries\\color{HandoutTeal}Exercise.}\\enspace",
  "\\ProofOf": "\\par\\smallskip\\noindent{\\itshape\\color{HandoutInk}Proof of #1.}\\enspace",
